# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=          # required — generate: openssl rand -hex 16
POSTGRES_DB=moviesdb
POSTGRES_PORT=5432
POSTGRES_HOST=db            # compose service name; use localhost for bare-metal

# JWT
JWT_SECRET=                 # required — generate: openssl rand -hex 32
JWT_EXPIRY_MINUTES=60       # optional — token lifetime in minutes (default: 60)

# App
APP_ENV=dev                 # dev | prod  (dev enables SQLAlchemy query logging)
APP_PORT=8000               # port the uvicorn server listens on
